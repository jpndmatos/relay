{
  "name": "relay-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/check-budget.mjs",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo && node scripts/check-budget.mjs dist-demo",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:performance": "node scripts/measure.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  }
}
